package: "com.android.nfc.module.flags"
container: "com.android.nfcservices"

flag {
    name: "nfc_hce_latency_events"
    is_exported: true
    namespace: "wallet_integration"
    description: "Enables tracking latency for HCE"
    bug: "379849603"
}

flag {
    name: "reader_mode_annotations_api"
    is_exported: true
    namespace: "nfc"
    description: "Enables NFC-A polling loop annotations in reader mode"
    bug: "398910589"
}

flag {
    name: "oem_extension_25q4"
    is_exported: true
    namespace: "nfc"
    description: "OEM extensions for Android 25Q4 release"
    bug: "402346002"
}

flag {
    name: "event_listener_offhost_aid_selected"
    is_exported: true
    namespace: "nfc"
    description: "Event listener callback for offhost AID select"
    bug: "396186563"
}

flag {
    name: "get_polling_loop_filters"
    is_exported: true
    namespace: "nfc"
    description: "API to fetch polling loop filters registered for HCE service"
    bug: "402776679"
}

flag {
    name: "screen_state_attribute_toggle"
    is_exported: true
    namespace: "nfc"
    description: "API to toggle requireDeviceUnlock and requireDeviceScreenOn attributes for HCE service."
    bug: "417742419"
}

flag {
    name: "nfc_power_saving_mode"
    is_exported: true
    namespace: "nfc"
    description: "API to get and set power saving mode."
    bug: "311419563"
}

flag {
    name: "deprecate_antenna_info"
    is_exported: true
    namespace: "nfc"
    description: "Deprecate isDeviceFoldable"
    bug: "395695630"
}

flag {
    name: "tap_to_x"
    is_exported: true
    namespace: "nfc"
    description: "Tap to X API for Android 17"
    bug: "416517337"
}

flag {
    name: "nfcstack_26q2_updates"
    is_exported: true
    namespace: "nfc"
    description: "This flags controls updates to nfc stack for 26Q2"
    bug: "446675679"
}

